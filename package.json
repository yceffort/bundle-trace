{
  "name": "coldpath",
  "version": "0.1.0",
  "description": "Trace which bundled JavaScript executes in real browser scenarios and why it is loaded",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yceffort/bundle-trace.git"
  },
  "type": "module",
  "bin": {
    "coldpath": "bin/coldpath.mjs"
  },
  "exports": {
    "./rollup": "./lib/rollup.mjs",
    "./vite": "./lib/rollup.mjs",
    "./webpack": "./lib/webpack.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib"
  ],
  "scripts": {
    "build": "cargo build --locked --release",
    "test": "cargo test --locked && pnpm test:browser && pnpm test:corpus && pnpm test:package",
    "test:corpus": "node scripts/verify-graphs.mjs && node scripts/verify-corpus.mjs",
    "test:browser": "node scripts/verify.mjs && node scripts/verify-formats.mjs && node scripts/verify-collector.mjs && node scripts/verify-environment.mjs && node scripts/verify-flows.mjs && node scripts/verify-treemap.mjs && node scripts/verify-comparison.mjs",
    "collect": "node bin/coldpath.mjs collect",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.29.9"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup": "4.63.4",
    "vite": "8.3.0",
    "webpack": "5.111.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.1.0"
}
